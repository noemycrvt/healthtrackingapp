EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Set to true to connect to the local Firebase emulators (docker compose up)
# instead of a real project. When true, the FIREBASE_* values above can be
# any placeholder strings, except PROJECT_ID should match .firebaserc's
# "default" project (demo-healthtrackingapp).
EXPO_PUBLIC_USE_FIREBASE_EMULATOR=false
